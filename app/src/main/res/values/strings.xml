    <string name="settings_data_title">数据</string>
    <string name="settings_export_title">导出全部记录</string>
    <string name="settings_export_body">计划通过系统文件选择器导出加密 ZIP，包含原始数据与观察摘要；当前版本尚未接入真实导出，也不会创建文件。</string>
